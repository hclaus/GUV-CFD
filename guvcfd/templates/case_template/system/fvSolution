FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    Phi
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.1;
        smoother        GaussSeidel;
    }
    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega|age)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
    "(U|k|omega|age)Final"
    {
        $U;
        relTol          0;
    }

    // T gets its own solver, distinct from the plain smoothSolver/
    // GaussSeidel group above - the UV sink term (constant/fvOptions'
    // scalarSemiImplicitSource) can concentrate an 80-300x-of-neighbors
    // coefficient into a handful of cells right at a lamp's peak-
    // intensity direction (confirmed on a real case), and plain
    // Gauss-Seidel smoothing struggles with that kind of extreme local
    // coefficient heterogeneity even though the sink term itself is
    // semi-implicit (theoretically unconditionally stable in isolation) -
    // a real diverged run traced to exactly this. PBiCGStab+DILU is a
    // standard, more robust choice for a scalar transport equation with a
    // stiff, spatially uneven source/sink term.
    T
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.1;
    }
    TFinal
    {
        $T;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 3;
    nCorrectors      2;
    nNonOrthogonalCorrectors 0;
    turbOnFinalIterOnly false;
    residualControl
    {
        p
        {
            tolerance   1e-4;
            relTol      0;
        }
        U
        {
            tolerance   1e-4;
            relTol      0;
        }
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      no;
    residualControl
    {
        p               1e-4;
        U               1e-4;
        "(k|omega)"     1e-4;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        "(k|omega)"     0.7;
        T               0.7;
        age             0.7;
    }
}
