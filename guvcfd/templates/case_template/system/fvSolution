FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    Phi
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.1;
        smoother        GaussSeidel;
    }
    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega|age)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
    "(U|k|omega|age)Final"
    {
        $U;
        relTol          0;
    }

    // T gets its own solver, distinct from the plain smoothSolver/
    // GaussSeidel group above - the UV sink term (constant/fvOptions'
    // scalarSemiImplicitSource) can concentrate an extreme coefficient
    // (confirmed on a real case: up to 1024x its neighbors, at cells
    // sitting in a lamp's peak-intensity direction) into a handful of
    // cells. PBiCGStab+DILU was tried first (2026-08-21) and did NOT fix
    // a real diverged case - the per-iteration LINEAR solve converged
    // tightly (residual ratio ~25000x) even as the field's own value grew
    // ~500x per OUTER iteration, meaning the instability isn't really a
    // linear-solver-robustness problem at all, it's upstream in the outer
    // (SIMPLE) loop's own update - but GAMG is tried next anyway since
    // it's a genuinely different algorithm (multigrid, not Krylov) and
    // cheap to rule out before concluding the fix has to be relaxation
    // (or the source term itself) instead of solver choice.
    T
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0.1;
        smoother        GaussSeidel;
    }
    TFinal
    {
        $T;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 3;
    nCorrectors      2;
    nNonOrthogonalCorrectors 0;
    turbOnFinalIterOnly false;
    residualControl
    {
        p
        {
            tolerance   1e-4;
            relTol      0;
        }
        U
        {
            tolerance   1e-4;
            relTol      0;
        }
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      no;
    residualControl
    {
        p               1e-4;
        U               1e-4;
        "(k|omega)"     1e-4;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        "(k|omega)"     0.7;
        T               0.7;
        age             0.7;
    }
}
