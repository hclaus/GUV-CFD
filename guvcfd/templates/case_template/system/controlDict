FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;
startFrom        startTime;
startTime        0;
stopAt           endTime;
endTime          8000;
deltaT           1;
writeControl     adjustableRunTime;
writeInterval    200;
purgeWrite       0;
writeFormat      ascii;
writePrecision   6;
writeCompression off;
timeFormat       general;
timePrecision    6;
runTimeModifiable true;

adjustTimeStep   yes;
// PIMPLE (system/fvSolution) runs with nOuterCorrectors 3, specifically so
// it stays stable well above Co=1 (unlike PISO) - 0.5 left most of that
// headroom unused and let a single locally-high-velocity cell (e.g. near a
// diffuser) throttle deltaT for the whole domain (confirmed directly: a
// UV-off control run's adaptive deltaT collapsed to ~0.08s, on track for
// tens of thousands of steps to cover a ~1400s target). Every use of this
// solver here (control runs, decay's UV-on/UV-off runs) only cares about
// the bulk room-average concentration's decay RATE (fit via regression -
// see decay_analysis.fit_effective_decay_rate), not fine local transient
// flow structure, so trading some of that for speed is the right call.
maxCo            5;
maxDeltaT        5;

functions
{
    scalarTransport1
    {
        enabled         true;
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");
        field           T;
        tolerance       1e-4;
        nCorr           3;
        phi             phi;
        nut             nut;
        alphaD          1;
        alphaDt         1;
        fvOptions
        {
        contaminantSource
        {
            type            scalarSemiImplicitSource;
            active          true;

            scalarSemiImplicitSourceCoeffs
            {
                selectionMode   cellZone;
                cellZone        sourceZone;
                volumeMode      specific;

                injectionRateSuSp
                {
                    T           (2.343750e-01 0);
                }
            }
        }

        fanSource
        {
            type            meanVelocityForce;
            active          true;

            meanVelocityForceCoeffs
            {
                selectionMode   cellZone;
                cellZone        fanZone;
                fields          (U);
                Ubar            (0 0 -0.3);
            }
        }
        }
        executeControl  timeStep;
        executeInterval 1;
        writeControl    adjustableRunTime;
        writeInterval   200;
    }

    scalarTransport2
    {
        enabled         true;
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");
        field           age;
        tolerance       1e-4;
        nCorr           3;
        phi             phi;
        nut             nut;
        alphaD          1;
        alphaDt         1;
        fvOptions
        {
        ageSource
        {
            type            scalarSemiImplicitSource;
            active          true;

            scalarSemiImplicitSourceCoeffs
            {
                selectionMode   all;
                volumeMode      specific;

                injectionRateSuSp
                {
                    age         (1.0 0);
                }
            }
        }
        }
        executeControl  timeStep;
        executeInterval 1;
        writeControl    adjustableRunTime;
        writeInterval   200;
    }
}
